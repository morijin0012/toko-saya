APP_NAME="Toko Saya"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# DATABASE — SQLite adalah database utama untuk mode offline. JANGAN
# ganti ke mysql/pgsql untuk build offline/NativePHP.
# ---------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_DATABASE=  # kosongkan agar memakai database/database.sqlite (default)
# DB_FOREIGN_KEYS=true
# DB_BUSY_TIMEOUT=5000   # ms, sebelum SQLite melempar error "database is locked"
# DB_JOURNAL_MODE=WAL    # mode jurnal SQLite yang lebih ramah untuk akses lokal
# DB_SYNCHRONOUS=NORMAL

# ---------------------------------------------------------------------
# SESSION / CACHE / QUEUE — semua memakai driver "database" (tabel SQLite
# lokal: sessions, cache, jobs). Ini SENGAJA, supaya aplikasi tidak
# bergantung pada Redis/Memcached/layanan eksternal apa pun saat offline.
# ---------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# MAIL_MAILER=log — cukup dicatat ke log, aplikasi ini tidak mengirim email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# VITE_DEV_LAN_HOST=  # isi dengan IP LAN laptop HANYA jika ingin akses `npm run dev` dari HP lewat Wi-Fi. Kosongkan untuk pengembangan normal di localhost.

# ---------------------------------------------------------------------
# Catatan untuk migrasi ke NativePHP Mobile (tahap berikutnya, BUKAN
# sekarang):
# - APP_URL nantinya tidak lagi relevan sebagai URL jaringan; NativePHP
#   menjalankan Laravel secara lokal di dalam aplikasi Android.
# - DB_DATABASE akan diarahkan NativePHP ke lokasi penyimpanan lokal
#   perangkat (bukan path Windows/laptop manapun).
# - SESSION_DRIVER/CACHE_STORE/QUEUE_CONNECTION di atas (database) sudah
#   kompatibel dan tidak perlu diubah untuk NativePHP.
# - Variabel MEMCACHED_*/REDIS_*/AWS_*/S3 dari skeleton Laravel bawaan
#   sengaja TIDAK disertakan di sini karena tidak dipakai aplikasi ini
#   dan tidak dibutuhkan untuk mode offline.
# ---------------------------------------------------------------------
